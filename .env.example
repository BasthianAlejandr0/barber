# Copia este archivo como .env y cambia los valores.

# Contraseña para entrar al panel (/admin)
ADMIN_PASSWORD=cambia-esta-clave

# Puerto del servidor en producción (npm start). En desarrollo la API usa siempre el 3001.
PORT=3001

# Zona horaria de la barbería (solo se usa al crear los datos iniciales)
TIMEZONE=America/Santiago

# Opcional: secreto para firmar las sesiones. Si no se define, se deriva de la contraseña.
# SESSION_SECRET=

# Opcional: carpeta donde se guarda db.json
# DATA_DIR=./server/data

# Opcional: si el servidor queda detrás de un proxy (Nginx, Render, etc.)
# TRUST_PROXY=1
