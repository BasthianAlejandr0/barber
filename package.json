{
  "name": "amilcar-barbero",
  "private": true,
  "version": "1.0.0",
  "description": "Agendamiento de horas para Amílcar Barbero",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,white \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js --port 3001",
    "dev:web": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "node --env-file-if-exists=.env server/demo.js",
    "reset": "node --env-file-if-exists=.env server/reset.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
